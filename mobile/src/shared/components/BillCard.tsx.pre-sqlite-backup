import { Pressable, StyleSheet, Text, View } from 'react-native';
import { router } from 'expo-router';

import type { Bill } from '@/shared/data/bills';
import {
  colors,
  fonts,
  fontSizes,
  fontWeights,
  radii,
  spacing,
} from '@/shared/theme';
import { formatMoney } from '@/shared/utils/format';

type BillCardProps = {
  bill: Bill;
  showDate?: boolean;
};

export default function BillCard({ bill, showDate = false }: BillCardProps) {
  return (
    <Pressable
      onPress={() => router.push('/bill-done')}
      accessibilityRole="button"
      accessibilityLabel={`Bill ${bill.number}`}
      style={({ pressed }) => [styles.card, pressed && styles.pressed]}
    >
      <View style={styles.left}>
        <Text style={styles.title}>{`Bill #${bill.number}`}</Text>
        <Text style={styles.summary}>{`${bill.itemsSummary} · ${bill.itemCount} items`}</Text>
        {showDate ? <Text style={styles.date}>{`${bill.date} · ${bill.time}`}</Text> : null}
      </View>
      <View style={styles.right}>
        <Text style={styles.total}>{formatMoney(bill.total)}</Text>
        <Text
          style={[
            styles.tag,
            bill.payment === 'cash' ? styles.tagCash : styles.tagUdhaar,
          ]}
        >
          {bill.payment === 'cash' ? 'Cash' : 'Udhaar'}
        </Text>
      </View>
    </Pressable>
  );
}

const styles = StyleSheet.create({
  card: {
    alignItems: 'center',
    backgroundColor: colors.white,
    borderColor: colors.borderCard,
    borderRadius: radii.lg,
    borderWidth: 1,
    flexDirection: 'row',
    gap: spacing.md,
    paddingHorizontal: spacing.lg,
    paddingVertical: spacing.md,
  },

  pressed: {
    opacity: 0.8,
  },

  left: {
    flex: 1,
    gap: 2,
  },

  right: {
    alignItems: 'flex-end',
    gap: 2,
  },

  title: {
    color: colors.ink,
    fontFamily: fonts.body,
    fontSize: fontSizes.bodyLarge - 1,
    fontWeight: fontWeights.semibold,
  },

  summary: {
    color: colors.textCaption,
    fontFamily: fonts.body,
    fontSize: fontSizes.caption,
  },

  date: {
    color: colors.textCaption,
    fontFamily: fonts.body,
    fontSize: fontSizes.caption,
  },

  total: {
    color: colors.ink,
    fontFamily: fonts.body,
    fontSize: fontSizes.bodyLarge - 1,
    fontWeight: fontWeights.semibold,
  },

  tag: {
    fontFamily: fonts.body,
    fontSize: 12,
    fontWeight: fontWeights.semibold,
  },

  tagCash: {
    color: colors.successGreen,
  },

  tagUdhaar: {
    color: colors.orangeText,
  },
});
