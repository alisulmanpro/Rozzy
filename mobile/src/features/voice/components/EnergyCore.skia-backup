import { useEffect, useRef, useState } from 'react';
import { StyleSheet, View } from 'react-native';
import { Canvas, Fill, Shader, Skia, vec } from '@shopify/react-native-skia';

type EnergyCoreProps = {
  audioLevel: number;
  isListening: boolean;
};

const SIZE = 340;

const ENERGY_SHADER = `
uniform float2 iResolution;
uniform float uTime;
uniform float uAudio;

float hash21(float2 p) {
  p = fract(p * float2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

float noise2(float2 p) {
  float2 i = floor(p);
  float2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);

  float a = hash21(i);
  float b = hash21(i + float2(1.0, 0.0));
  float c = hash21(i + float2(0.0, 1.0));
  float d = hash21(i + float2(1.0, 1.0));

  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(float2 p) {
  float value = 0.0;
  float amplitude = 0.5;

  for (int i = 0; i < 4; i++) {
    value += noise2(p) * amplitude;
    p = p * 2.03 + float2(13.1, 7.7);
    amplitude *= 0.5;
  }

  return value;
}

half4 main(float2 pos) {
  float2 uv = (pos - iResolution * 0.5) / (iResolution.y * 0.5);
  float radius = length(uv);
  float angle = atan(uv.y, uv.x);
  float t = uTime;
  float energy = uAudio;

  float2 flow = uv * 4.0;
  flow += float2(
    sin(t * 0.7) * energy,
    cos(t * 0.6) * energy
  );

  float cloud = fbm(flow + float2(t * 0.3, -t * 0.22));
  float detail = fbm(flow * 2.4 + cloud * 1.8);

  float distortion =
    sin(angle * 5.0 + cloud * 8.0 + t * 1.8) * 0.012 * energy;

  distortion +=
    sin(angle * 9.0 - cloud * 6.0 - t * 1.2) * 0.008 * energy;

  float coreRadius = 0.405 + distortion;
  float coreMask = 1.0 - smoothstep(coreRadius - 0.012, coreRadius + 0.012, radius);

  float outerGlow = exp(-max(radius - 0.36, 0.0) * 12.0);
  outerGlow *= smoothstep(0.78, 0.35, radius);

  float haloNoise = fbm(uv * 7.0 + float2(t * 0.4, -t * 0.3));
  float organicCloud = smoothstep(0.34, 0.78, haloNoise);
  organicCloud *= smoothstep(0.82, 0.38, radius);
  organicCloud *= (1.0 - smoothstep(0.36, 0.44, radius));

  float ribbonWave = sin(
    angle * 8.0 + radius * 23.0 - t * 2.4 + cloud * 5.0
  );

  float ribbons = exp(-abs(ribbonWave) * 8.0);
  ribbons *= smoothstep(0.43, 0.51, radius);
  ribbons *= 1.0 - smoothstep(0.74, 0.83, radius);
  ribbons *= energy;

  float3 color = float3(0.0);

  color += float3(0.12, 0.08, 0.65) * outerGlow * 0.42;
  color += float3(0.36, 0.08, 0.95) * organicCloud * 0.9;
  color += float3(0.08, 0.65, 1.0) * ribbons * 0.8;

  // Glossy liquid sphere
  float3 sphereColor = mix(
    float3(0.055, 0.015, 0.22),
    float3(0.34, 0.055, 0.82),
    smoothstep(-0.65, 0.65, uv.y + cloud * 0.12)
  );

  sphereColor = mix(
    sphereColor,
    float3(0.035, 0.48, 0.82),
    smoothstep(0.28, 0.85, detail) * 0.48
  );

  float2 lightPosition = uv - float2(-0.20, -0.24);
  float specular = exp(-dot(lightPosition, lightPosition) * 95.0);
  float softHighlight = exp(-dot(lightPosition, lightPosition) * 18.0);

  sphereColor += float3(0.8, 0.55, 1.0) * specular * 0.9;
  sphereColor += float3(0.35, 0.55, 1.0) * softHighlight * 0.24;

  float liquidLines = sin(
    uv.x * 19.0 + sin(uv.y * 13.0 + t * 1.4) * 2.0
    + cloud * 5.0
  );

  liquidLines = exp(-abs(liquidLines) * 5.0);
  sphereColor += float3(0.22, 0.35, 0.85) * liquidLines * 0.18;

  color = mix(color, sphereColor, coreMask);

  // Circular audio waveform: visible and animated only while speaking
  float waveNoise = fbm(
    float2(angle * 2.8, t * 2.2 + cloud * 2.0)
  );

  float waveShape =
    sin(angle * 42.0 + t * 7.0) * 0.45
    + sin(angle * 73.0 - t * 5.0) * 0.25
    + (waveNoise - 0.5) * 1.1;

  float waveRadius = 0.505 + waveShape * 0.075 * energy;
  float waveDistance = abs(radius - waveRadius);

  float audioWave = exp(-waveDistance * 105.0);
  audioWave *= smoothstep(0.10, 0.35, energy);
  audioWave *= smoothstep(0.48, 0.55, radius);
  audioWave *= 1.0 - smoothstep(0.78, 0.84, radius);

  float waveGlow = exp(-waveDistance * 24.0) * energy;

  color += float3(0.10, 0.78, 1.0) * audioWave * 1.8;
  color += float3(0.55, 0.18, 1.0) * waveGlow * 0.65;

  // Procedural particles around the energy field
  float particles = 0.0;
  float cyanParticles = 0.0;
  float purpleParticles = 0.0;

  for (int i = 0; i < 36; i++) {
    float fi = float(i);
    float seed = hash21(float2(fi, 17.3));
    float seed2 = hash21(float2(fi, 41.7));

    float particleAngle =
      seed * 6.28318 + t * (0.25 + seed2 * 0.7);

    float particleRadius =
      0.49 + seed2 * 0.31
      + sin(t * 1.7 + fi) * 0.018 * energy;

    float2 particlePosition = float2(
      cos(particleAngle),
      sin(particleAngle)
    ) * particleRadius;

    float particleDistance = length(uv - particlePosition);
    float particleSize = 0.006 + seed * 0.008;

    float particle = 1.0 - smoothstep(
      particleSize * 0.35,
      particleSize,
      particleDistance
    );

    particles += particle;
    cyanParticles += particle * step(0.5, seed);
    purpleParticles += particle * (1.0 - step(0.5, seed));
  }

  color += float3(0.16, 0.83, 1.0) * cyanParticles * energy * 1.5;
  color += float3(0.72, 0.24, 1.0) * purpleParticles * energy * 1.5;

  // Fine energy filaments
  float filamentNoise = fbm(uv * 12.0 + float2(t * 0.8, -t * 0.5));
  float filaments = exp(-abs(
    sin(angle * 13.0 + filamentNoise * 12.0 + t * 2.0)
  ) * 13.0);

  filaments *= smoothstep(0.44, 0.55, radius);
  filaments *= 1.0 - smoothstep(0.76, 0.84, radius);
  color += float3(0.12, 0.55, 1.0) * filaments * energy * 0.75;

  float alpha = max(
    coreMask,
    max(outerGlow * 0.42, organicCloud * 0.75)
  );

  alpha = max(alpha, (particles + filaments + audioWave) * energy * 0.85);
  alpha = clamp(alpha, 0.0, 1.0);

  return half4(half3(color), half(alpha));
}
`;

const energyEffect = Skia.RuntimeEffect.Make(ENERGY_SHADER);

export default function EnergyCore({
  audioLevel,
  isListening,
}: EnergyCoreProps) {
  const [time, setTime] = useState(0);
  const frameRef = useRef<number | null>(null);

  const level = Math.max(0, Math.min(1, audioLevel));
  const voiceThreshold = 0.38;
  const activeLevel = isListening && level > voiceThreshold
    ? Math.min(1, (level - voiceThreshold) / (1 - voiceThreshold))
    : 0;

  useEffect(() => {
    if (activeLevel <= 0) {
      if (frameRef.current !== null) {
        cancelAnimationFrame(frameRef.current);
        frameRef.current = null;
      }

      setTime(0);
      return;
    }

    const startedAt = Date.now();
    let lastUpdate = 0;

    const animate = () => {
      const now = Date.now();

      if (now - lastUpdate >= 33) {
        setTime((now - startedAt) / 1000);
        lastUpdate = now;
      }

      frameRef.current = requestAnimationFrame(animate);
    };

    frameRef.current = requestAnimationFrame(animate);

    return () => {
      if (frameRef.current !== null) {
        cancelAnimationFrame(frameRef.current);
        frameRef.current = null;
      }
    };
  }, [activeLevel > 0]);

  if (!energyEffect) {
    return <View style={styles.fallback} />;
  }

  return (
    <View style={styles.container}>
      <Canvas style={styles.canvas}>
        <Fill>
          <Shader
            source={energyEffect}
            uniforms={{
              iResolution: vec(SIZE, SIZE),
              uTime: time,
              uAudio: activeLevel,
            }}
          />
        </Fill>
      </Canvas>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    width: SIZE,
    height: SIZE,
    alignItems: 'center',
    justifyContent: 'center',
  },
  canvas: {
    width: SIZE,
    height: SIZE,
  },
  fallback: {
    width: SIZE,
    height: SIZE,
  },
});
