import { Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { router } from 'expo-router';

import Screen from '@/shared/components/Screen';
import { customers } from '@/shared/data/customers';
import {
  colors,
  fonts,
  fontSizes,
  fontWeights,
  radii,
  spacing,
} from '@/shared/theme';
import { formatMoney } from '@/shared/utils/format';

function initialsOf(name: string): string {
  return name
    .split(' ')
    .map((part) => part.charAt(0))
    .join('');
}

export default function CustomersScreen() {
  const udhaarTotal = customers.reduce(
    (sum, customer) => sum + customer.udhaarTotal,
    0,
  );

  return (
    <Screen>
      <ScrollView
        bounces={false}
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
      >
        <View style={styles.header}>
          <Text style={styles.title}>Customers</Text>
          <Text style={styles.subtitle}>{`Udhaar baqi · ${formatMoney(udhaarTotal)}`}</Text>
        </View>

        {customers.map((customer) => (
          <Pressable
            key={customer.id}
            onPress={() =>
              router.push({ pathname: '/customers/[id]', params: { id: customer.id } })
            }
            accessibilityRole="button"
            accessibilityLabel={customer.name}
            style={({ pressed }) => [styles.card, pressed && styles.pressed]}
          >
            <View style={styles.avatar}>
              <Text style={styles.avatarText}>{initialsOf(customer.name)}</Text>
            </View>
            <View style={styles.details}>
              <Text style={styles.name}>{customer.name}</Text>
              <Text style={styles.phone}>{customer.phone}</Text>
            </View>
            <View style={styles.balance}>
              <Text style={styles.balanceAmount}>{formatMoney(customer.udhaarTotal)}</Text>
              <Text style={styles.balanceLabel}>Udhaar</Text>
            </View>
          </Pressable>
        ))}
      </ScrollView>
    </Screen>
  );
}

