import { Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { Ionicons } from '@react-native-vector-icons/ionicons';
import { router } from 'expo-router';

import BillCard from '@/shared/components/BillCard';
import Screen from '@/shared/components/Screen';
import { getCustomer, getCustomerBills } from '@/shared/data/customers';
import {
  colors,
  fonts,
  fontSizes,
  fontWeights,
  radii,
  spacing,
} from '@/shared/theme';
import { formatMoney } from '@/shared/utils/format';

type CustomerDetailScreenProps = {
  customerId?: string;
};

export default function CustomerDetailScreen({ customerId }: CustomerDetailScreenProps) {
  const customer = customerId ? getCustomer(customerId) : undefined;
  const customerBills = customerId ? getCustomerBills(customerId) : [];

  return (
    <Screen>
      <View style={styles.topBar}>
        <Pressable
          onPress={() => router.back()}
          accessibilityLabel="Back"
          hitSlop={8}
          style={styles.backButton}
        >
          <Ionicons name="chevron-back" size={24} color={colors.ink} />
        </Pressable>
        <Text style={styles.title}>{customer ? customer.name : 'Customer'}</Text>
      </View>

      <ScrollView
        bounces={false}
        contentContainerStyle={styles.content}
        showsVerticalScrollIndicator={false}
      >
        {customer ? (
          <View style={styles.balanceCard}>
            <Text style={styles.balanceLabel}>Kul udhaar</Text>
            <Text style={styles.balanceAmount}>{formatMoney(customer.udhaarTotal)}</Text>
            <View style={styles.phoneRow}>
              <Ionicons name="call-outline" size={18} color={colors.violetLink} />
              <Text style={styles.phone}>{customer.phone}</Text>
            </View>
          </View>
        ) : (
          <Text style={styles.empty}>Customer nahi mila.</Text>
        )}

        {customer && customerBills.length > 0 ? (
          <>
            <Text style={styles.sectionTitle}>Pichle bills</Text>
            <View style={styles.billList}>
              {customerBills.map((bill) => (
                <BillCard key={bill.id} bill={bill} showDate />
              ))}
            </View>
          </>
        ) : null}

        {customer && customerBills.length === 0 ? (
          <Text style={styles.empty}>Koi udhaar bill nahi.</Text>
        ) : null}
      </ScrollView>
    </Screen>
  );
}

const styles = StyleSheet.create({
  topBar: {
    alignItems: 'center',
    flexDirection: 'row',
    gap: spacing.sm,
    paddingHorizontal: spacing.lg,
  },

  backButton: {
    alignItems: 'center',
    height: 44,
    justifyContent: 'center',
    width: 44,
  },

  title: {
    color: colors.ink,
    flex: 1,
    fontFamily: fonts.heading,
    fontSize: fontSizes.bodyLarge + 2,
    fontWeight: fontWeights.semibold,
  },

  content: {
    paddingBottom: spacing.xxl,
    paddingHorizontal: spacing.xl,
    paddingTop: spacing.sm,
  },

  balanceCard: {
    backgroundColor: colors.white,
    borderColor: colors.borderCard,
    borderRadius: radii.xl,
    borderWidth: 1,
    gap: 6,
    padding: spacing.lg,
  },

  balanceLabel: {
    color: colors.textCaption,
    fontFamily: fonts.body,
    fontSize: fontSizes.caption,
    fontWeight: fontWeights.semibold,
  },

  balanceAmount: {
    color: colors.ink,
    fontFamily: fonts.heading,
    fontSize: fontSizes.display + 2,
    fontWeight: fontWeights.bold,
  },

  phoneRow: {
    alignItems: 'center',
    flexDirection: 'row',
    gap: spacing.sm,
    marginTop: spacing.xs,
  },

  phone: {
    color: colors.textSecondary,
    fontFamily: fonts.body,
    fontSize: fontSizes.body,
  },

  sectionTitle: {
    color: colors.ink,
    fontFamily: fonts.heading,
    fontSize: fontSizes.bodyLarge + 1,
    fontWeight: fontWeights.semibold,
    marginTop: spacing.xl,
  },

  billList: {
    gap: 10,
    marginTop: spacing.md,
  },

  empty: {
    color: colors.textCaption,
    fontFamily: fonts.body,
    fontSize: fontSizes.body,
    marginTop: spacing.xl,
    textAlign: 'center',
  },
});
