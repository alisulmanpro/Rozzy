import { useEffect, useState } from 'react';
import {
  ActivityIndicator,
  Image,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from 'react-native';
import { Ionicons } from '@react-native-vector-icons/ionicons';
import { router } from 'expo-router';

import { getActiveShop } from '@/core/database/repositories/shopRepository';
import BillCard from '@/shared/components/BillCard';
import Card from '@/shared/components/Card';
import Screen from '@/shared/components/Screen';
import { bills, todayStats } from '@/shared/data/bills';
import {
  colors,
  fonts,
  fontSizes,
  fontWeights,
  radii,
  spacing,
} from '@/shared/theme';
import { formatMoney } from '@/shared/utils/format';

const logoSource = require('../../../assets/rozzy-logo.png');

export default function HomeScreen() {
  const [shopName, setShopName] = useState('');
  const [isLoading, setIsLoading] = useState(true);
  const [loadError, setLoadError] = useState<string | null>(null);

  useEffect(() => {
    let mounted = true;

    async function loadShop() {
      try {
        const shop = await getActiveShop();

        if (!mounted) return;

        if (!shop) {
          router.replace('/shop-setup');
          return;
        }

        setShopName(shop.name);
      } catch (error) {
        if (mounted) {
          setLoadError(
            error instanceof Error
              ? error.message
              : 'Dukaan ki maloomat load nahi ho saki.',
          );
        }
      } finally {
        if (mounted) {
          setIsLoading(false);
        }
      }
    }

    void loadShop();

    return () => {
      mounted = false;
    };
  }, []);

  if (isLoading) {
    return (
      <Screen edges={['top']}>
        <View style={styles.stateContainer}>
          <ActivityIndicator size="large" color={colors.violet} />
          <Text style={styles.stateText}>Dukaan load ho rahi hai...</Text>
        </View>
      </Screen>
    );
  }

  if (loadError) {
    return (
      <Screen edges={['top']}>
        <View style={styles.stateContainer}>
          <Text style={styles.errorTitle}>Dukaan load nahi ho saki</Text>
          <Text style={styles.stateText}>{loadError}</Text>
          <Pressable
            onPress={() => router.replace('/shop-setup')}
            accessibilityRole="button"
          >
            <Text style={styles.retryText}>Shop setup par wapas jayein</Text>
          </Pressable>
        </View>
      </Screen>
    );
  }

  if (!shopName) {
    return null;
  }

  return (
    <Screen edges={['top']}>
      <ScrollView contentContainerStyle={styles.content}>
        <View style={styles.header}>
          <Image source={logoSource} style={styles.logo} />
          <View style={styles.headerText}>
            <Text style={styles.greeting}>Assalam o Alaikum</Text>
            <Text style={styles.shopName}>{shopName}</Text>
          </View>
        </View>

        <Card style={styles.saleCard}>
          <Text style={styles.saleLabel}>Aaj ki sale</Text>
          <Text style={styles.saleTotal}>{formatMoney(todayStats.saleTotal)}</Text>
          <View style={styles.statsRow}>
            <View style={[styles.statChip, styles.statChipViolet]}>
              <Text style={[styles.statLabel, styles.statLabelViolet]}>Bills</Text>
              <Text style={styles.statValue}>{todayStats.billCount}</Text>
            </View>
            <Pressable
              onPress={() => router.push('/customers')}
              accessibilityRole="button"
              accessibilityLabel="Udhaar baqi"
              style={({ pressed }) => [styles.statChip, styles.statChipOrange, pressed && styles.pressed]}
            >
              <Text style={[styles.statLabel, styles.statLabelOrange]}>Udhaar baqi</Text>
              <Text style={styles.statValue}>{formatMoney(todayStats.udhaarTotal)}</Text>
            </Pressable>
          </View>
        </Card>

        <Pressable
          onPress={() => router.push('/bill')}
          accessibilityRole="button"
          accessibilityLabel="Naya Bill"
          style={({ pressed }) => [styles.newBillButton, pressed && styles.pressed]}
        >
          <Ionicons name="mic" size={26} color={colors.white} />
          <Text style={styles.newBillLabel}>Naya Bill</Text>
        </Pressable>

        <View style={styles.sectionHeader}>
          <Text style={styles.sectionTitle}>Pichle bills</Text>
          <Pressable
            onPress={() => router.navigate('/bills')}
            accessibilityRole="button"
            hitSlop={8}
          >
            <Text style={styles.sectionLink}>Sab dekhein</Text>
          </Pressable>
        </View>

        <View style={styles.billList}>
          {bills.slice(0, 3).map((bill) => (
            <BillCard key={bill.id} bill={bill} />
          ))}
        </View>
      </ScrollView>
    </Screen>
  );
}

