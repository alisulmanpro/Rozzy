import { Pressable, StyleSheet, Text, View } from 'react-native';
import { router } from 'expo-router';

import type { BillRecord } from '@/core/database/repositories/billRepository';
import {
  colors,
  fonts,
  fontSizes,
  fontWeights,
  radii,
  spacing,
} from '@/shared/theme';
import { formatRupees } from '@/shared/utils/format';

type BillCardProps = {
  bill: BillRecord;
  showDate?: boolean;
};

function formatBillDate(value: string) {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleString('en-PK', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
}

function getPaymentLabel(status: BillRecord['payment_status']) {
  if (status === 'paid') return 'Paid';
  if (status === 'partial') return 'Partial';
  return 'Udhaar';
}

export default function BillCard({ bill, showDate = false }: BillCardProps) {
  const itemNames = bill.items
    .slice(0, 3)
    .map((item) => item.product_name)
    .join(', ');

  const remainingNames = bill.items.length - 3;
  const summary = remainingNames > 0
    ? `${itemNames} +${remainingNames} more`
    : itemNames;

  return (
    <Pressable
      onPress={() =>
        router.push({
          pathname: '/bill-done',
          params: { billId: bill.id },
        })
      }
      accessibilityRole="button"
      accessibilityLabel={`Bill ${bill.bill_number}`}
      style={({ pressed }) => [styles.card, pressed && styles.pressed]}
    >
      <View style={styles.left}>
        <Text style={styles.title}>{`Bill #${bill.bill_number}`}</Text>
        <Text style={styles.summary}>
          {`${summary || 'No items'} · ${bill.items.length} items`}
        </Text>
        {showDate ? (
          <Text style={styles.date}>{formatBillDate(bill.created_at)}</Text>
        ) : null}
      </View>

      <View style={styles.right}>
        <Text style={styles.total}>{formatRupees(bill.total)}</Text>
        <Text
          style={[
            styles.tag,
            bill.payment_status === 'paid'
              ? styles.tagPaid
              : styles.tagUdhaar,
          ]}
        >
          {getPaymentLabel(bill.payment_status)}
        </Text>
      </View>
    </Pressable>
  );
}

const styles = StyleSheet.create({
  card: {
    alignItems: 'center',
    backgroundColor: colors.white,
    borderColor: colors.borderCard,
    borderRadius: radii.lg,
    borderWidth: 1,
    flexDirection: 'row',
    gap: spacing.md,
    paddingHorizontal: spacing.lg,
    paddingVertical: spacing.md,
  },
  pressed: {
    opacity: 0.8,
  },
  left: {
    flex: 1,
    gap: 2,
  },
  right: {
    alignItems: 'flex-end',
    gap: 2,
  },
  title: {
    color: colors.ink,
    fontFamily: fonts.body,
    fontSize: fontSizes.bodyLarge - 1,
    fontWeight: fontWeights.semibold,
  },
  summary: {
    color: colors.textCaption,
    fontFamily: fonts.body,
    fontSize: fontSizes.caption,
  },
  date: {
    color: colors.textCaption,
    fontFamily: fonts.body,
    fontSize: fontSizes.caption,
  },
  total: {
    color: colors.ink,
    fontFamily: fonts.body,
    fontSize: fontSizes.bodyLarge - 1,
    fontWeight: fontWeights.semibold,
  },
  tag: {
    fontFamily: fonts.body,
    fontSize: 12,
    fontWeight: fontWeights.semibold,
  },
  tagPaid: {
    color: colors.successGreen,
  },
  tagUdhaar: {
    color: colors.orangeText,
  },
});
