import { useMemo, useState } from 'react';
import { FlatList, Pressable, StyleSheet, Text, View } from 'react-native';
import { Ionicons } from '@react-native-vector-icons/ionicons';
import { router } from 'expo-router';

import Screen from '@/shared/components/Screen';
import SearchBar from '@/shared/components/SearchBar';
import { products } from '@/shared/data/products';
import type { Product } from '@/shared/data/products';
import {
  colors,
  fonts,
  fontSizes,
  fontWeights,
  radii,
  spacing,
} from '@/shared/theme';

export default function ProductsScreen() {
  const [query, setQuery] = useState('');

  const filteredProducts = useMemo(() => {
    const normalized = query.trim().toLowerCase();
    if (!normalized) {
      return products;
    }
    return products.filter(
      (product) =>
        product.name.toLowerCase().includes(normalized) ||
        product.aliases.some((alias) => alias.includes(normalized)),
    );
  }, [query]);

  return (
    <Screen edges={['top']}>
      <View style={styles.header}>
        <Text style={styles.title}>Products</Text>
        <Text style={styles.count}>{`${products.length} cheezein`}</Text>
      </View>

      <FlatList
        data={filteredProducts}
        keyExtractor={(item) => item.id}
        keyboardShouldPersistTaps="handled"
        ListEmptyComponent={<Text style={styles.empty}>Kuch nahi mila.</Text>}
        ListHeaderComponent={
          <View>
            <SearchBar placeholder="Cheez dhoondein" value={query} onChangeText={setQuery} />
            <View style={styles.listTopGap} />
          </View>
        }
        contentContainerStyle={styles.listContent}
        renderItem={({ item }) => <ProductCard product={item} />}
        showsVerticalScrollIndicator={false}
      />

      <Pressable
        onPress={() => router.push('/add-product')}
        accessibilityRole="button"
        accessibilityLabel="Nayi cheez"
        style={({ pressed }) => [styles.fab, pressed && styles.pressed]}
      >
        <Ionicons name="add" size={20} color={colors.white} />
        <Text style={styles.fabLabel}>Nayi cheez</Text>
      </Pressable>
    </Screen>
  );
}

function ProductCard({ product }: { product: Product }) {
  return (
    <View style={styles.card}>
      <View style={styles.cardDetails}>
        <Text style={styles.cardName}>{product.name}</Text>
        <Text style={styles.cardAliases}>{`Bolne ke alfaz: ${product.aliases.join(', ')}`}</Text>
      </View>
      <View style={styles.cardPricing}>
        <Text style={styles.cardPrice}>{`Rs ${product.price}`}</Text>
        <Text style={styles.cardUnit}>{`per ${product.unit}`}</Text>
      </View>
    </View>
  );
}

