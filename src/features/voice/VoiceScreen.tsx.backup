import { Pressable, ScrollView, StyleSheet, Text, View } from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { Ionicons } from '@react-native-vector-icons/ionicons';
import { router } from 'expo-router';
import { SafeAreaView } from 'react-native-safe-area-context';

import Badge from '@/shared/components/Badge';
import {
  colors,
  fonts,
  fontSizes,
  fontWeights,
  radii,
  spacing,
} from '@/shared/theme';

const WAVEFORM_HEIGHTS = [22, 40, 62, 30, 70, 44, 56, 26, 38];

export default function VoiceScreen() {
  return (
    <LinearGradient
      colors={[colors.voiceBg, colors.background]}
      locations={[0, 0.55]}
      style={styles.gradient}
    >
      <SafeAreaView edges={['top', 'bottom']} style={styles.safeArea}>
        <View style={styles.topBar}>
          <Pressable
            onPress={() => router.back()}
            accessibilityLabel="Band karein"
            hitSlop={8}
            style={styles.closeButton}
          >
            <Ionicons name="close" size={24} color={colors.ink} />
          </Pressable>
          <Text style={styles.title}>Rozzy AI</Text>
          <Badge label="Roman Urdu" />
        </View>

        <Text style={styles.hint}>{'Kabhi bhi kahein: "Hey Rozzy"'}</Text>

        <ScrollView
          bounces={false}
          contentContainerStyle={styles.middle}
          showsVerticalScrollIndicator={false}
        >
          <View style={styles.orbStack}>
            <View style={styles.ringOuter} />
            <View style={styles.ringMiddle} />
            <View style={styles.ringInner} />
            <View style={styles.orb}>
              <View style={styles.spotOrange} />
              <View style={styles.spotCoral} />
              <View style={styles.spotMagenta} />
              <View style={styles.spotWhite} />
              <View style={styles.waveform}>
                {WAVEFORM_HEIGHTS.map((height) => (
                  <View key={height} style={[styles.waveBar, { height }]} />
                ))}
              </View>
            </View>
          </View>

          <Text style={styles.listening}>Main sun raha hoon…</Text>

          <View style={styles.transcript}>
            <Text style={styles.transcriptLabel}>Aap ne kaha</Text>
            <Text style={styles.transcriptText}>
              do kilo ata 40 rupay, ek kilo khand 150 rupay aur{' '}
              <Text style={styles.transcriptHighlight}>pachaas rupay ki ilachi</Text>
            </Text>
          </View>
        </ScrollView>

        <View style={styles.controls}>
          <Pressable
            onPress={() => router.navigate('/bill')}
            accessibilityLabel="Likh kar bataein"
            style={({ pressed }) => [styles.controlButton, pressed && styles.pressed]}
          >
            <Ionicons name="keypad-outline" size={24} color={colors.ink} />
          </Pressable>
          <Pressable
            onPress={() => router.navigate('/bill')}
            accessibilityLabel="Bolna band karein"
            style={({ pressed }) => [styles.stopButton, pressed && styles.pressed]}
          >
            <View style={styles.stopSquare} />
          </Pressable>
          <Pressable
            onPress={() => {}}
            accessibilityLabel="Madad"
            style={({ pressed }) => [styles.controlButton, pressed && styles.pressed]}
          >
            <Text style={styles.helpLabel}>?</Text>
          </Pressable>
        </View>
      </SafeAreaView>
    </LinearGradient>
  );
}

