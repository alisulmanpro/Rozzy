type BillScreenProps = {
  resolved?: boolean;
};

export default function BillScreen({ resolved = false }: BillScreenProps) {
  const total = resolved ? 280 : 230;

  return (
    <Screen>
      <KeyboardAvoidingView
        behavior={Platform.OS === 'ios' ? 'padding' : undefined}
        enabled={Platform.OS === 'ios'}
