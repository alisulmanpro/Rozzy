          <View style={styles.transcript}>
            <Text style={styles.transcriptLabel}>Aap ne kaha</Text>
            <Text style={styles.transcriptText}>
              do kilo ata 40 rupay, ek kilo khand 150 rupay, aur 50 rupee ki ilachi
            </Text>
          </View>

          <View style={styles.itemsHeader}>
            <Text style={styles.itemsCount}>3 items</Text>
            {resolved ? null : (
              <Text style={styles.reviewPill}>1 check karein</Text>
            )}
          </View>

          <View style={styles.itemList}>
            <View style={styles.itemCard}>
              <View style={styles.itemDetails}>
                <Text style={styles.itemName}>Ata</Text>
                <Text style={styles.itemMeta}>2 kg × Rs 40 / kg</Text>
              </View>
              <Text style={styles.itemTotal}>Rs 80</Text>
            </View>

            <View style={styles.itemCard}>
              <View style={styles.itemDetails}>
                <Text style={styles.itemName}>Cheeni</Text>
                <Text style={styles.itemMeta}>{'1 kg × Rs 150 / kg · "khand"'}</Text>
              </View>
              <Text style={styles.itemTotal}>Rs 150</Text>
            </View>

            {resolved ? (
              <View style={styles.itemCard}>
                <View style={styles.itemDetails}>
                  <Text style={styles.itemName}>Ilachi</Text>
                  <Text style={styles.itemMeta}>100 gram · Rs 50</Text>
                </View>
                <Text style={styles.itemTotal}>Rs 50</Text>
              </View>
            ) : (
              <View style={styles.unresolvedCard}>
                <View style={styles.itemDetails}>
                  <Text style={styles.unresolvedName}>{'"ilachi" — samajh nahi aaya'}</Text>
                  <Text style={styles.unresolvedMeta}>Rs 50 (poori raqam) · qty nahi boli</Text>
                </View>
                <Pressable
                  onPress={() => router.push('/item-edit')}
                  accessibilityRole="button"
                  style={({ pressed }) => [
                    styles.resolveButton,
                    pressed && styles.pressed,
                  ]}
                >
                  <Text style={styles.resolveLabel}>Product chunein</Text>
                </Pressable>
              </View>
            )}
          </View>
        </ScrollView>

        <View style={styles.footer}>
          <View style={styles.totalRow}>
            <View style={styles.totalDetails}>
              <Text style={styles.totalLabel}>
                {resolved ? 'Total' : 'Total (ilachi ke baghair)'}
              </Text>
              <Text style={styles.totalAmount}>{formatMoney(total)}</Text>
            </View>
            <Pressable
              disabled={!resolved}
              onPress={() => router.push('/bill-done')}
              accessibilityRole="button"
              style={({ pressed }) => [
                resolved ? styles.ctaEnabled : styles.ctaDisabled,
                pressed && styles.pressed,
              ]}
            >
              <Text
                style={[
                  styles.ctaLabel,
                  resolved ? styles.ctaLabelEnabled : styles.ctaLabelDisabled,
                ]}
              >
                Bill banayein
              </Text>
            </Pressable>
          </View>

          <View style={styles.inputRow}>
            <TextInput
              style={styles.input}
              placeholder="Ya yahan likhein…"
              placeholderTextColor={colors.textCaption}
              multiline={false}
            />
            <Pressable
              onPress={() => router.push('/voice')}
              accessibilityLabel="Bolein"
              style={({ pressed }) => [styles.micButton, pressed && styles.pressed]}
            >
              <Ionicons name="mic" size={28} color={colors.white} />
            </Pressable>
          </View>
        </View>
      </KeyboardAvoidingView>
    </Screen>
  );
}

